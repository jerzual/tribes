{
  "name": "tribes-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tribes-api/src",
  "projectType": "application",
  "prefix": "tribes-api",
  "tags": [],
  "implicitDependencies": ["tribes-model", "tribes-engine"],
  "generators": {},
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "options": {
        "outputPath": "dist/apps/tribes-api",
        "main": "apps/tribes-api/src/main.ts",
        "tsConfig": "apps/tribes-api/tsconfig.app.json",
        "assets": ["apps/tribes-api/src/assets"],
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": false,
        "generatePackageJson": true
      },
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "tribes-api:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/apps/tribes-api"]
    }
  }
}
